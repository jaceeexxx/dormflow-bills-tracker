{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"same-origin"},{"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"}]}
  ],
  "crons": [{"path":"/api/reminders","schedule":"0 0 * * *"}]
}
